# Copiá este archivo como `.env` (ignorado por git) sólo si querés usar un modelo real.
# Sin estas variables todo funciona con el proveedor local determinista.

# Proveedor LLM real para el AI Agents Lab y el AI Study Mentor. La key sólo la lee el servidor.
ANTHROPIC_API_KEY=

# Modelo por defecto: claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5
AI_MODEL=claude-opus-5-5
# Modelo del evaluador "LLM as Judge" (por defecto, AI_MODEL)
AI_JUDGE_MODEL=

# Control de costos (por proceso): llamadas por minuto por cliente y presupuesto diario de llamadas
AI_RATE_LIMIT_PER_MINUTE=30
AI_DAILY_REQUEST_LIMIT=500

# PostgreSQL: docker compose ya apunta a la base local `db`. Definilo sólo para usar otra base (Neon, Supabase…).
# DATABASE_URL=postgres://usuario:clave@host:5432/base

# Cuentas (Fase 6). La primera cuenta registrada es administradora.
AUTH_ALLOW_SIGNUP=false
# Intentos de inicio de sesión o registro por IP (y email) cada 15 minutos
AUTH_MAX_ATTEMPTS=10
ADMIN_EMAILS=
# GitHub OAuth opcional (callback: http://localhost:3000/api/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_LOGINS=
